---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('learn')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title="Learn — Hidden Text & Prompt Injection in PDFs"
  description="Guides on hidden text in PDFs, prompt injection aimed at AI reviewers, the white-font résumé trick, and every place content can hide in a file."
  pathname="/learn"
>
  <section class="container max-w-2xl py-16">
    <h1 class="text-3xl font-bold tracking-tight">Learn</h1>
    <p class="mt-4 text-muted-foreground">
      How PDFs hide text, why hidden instructions are aimed at AI reviewers, and how to check a
      file for both. Plain explanations of the mechanisms this scanner detects.
    </p>

    <ul class="mt-10 space-y-8">
      {articles.map((article) => (
        <li class="border-t border-border pt-8">
          <a href={`/learn/${article.id}`} class="group block">
            <h2 class="text-xl font-semibold group-hover:text-primary">
              {article.data.title}
            </h2>
            <p class="mt-2 text-muted-foreground">{article.data.description}</p>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.15em] text-muted-foreground">
              {dateFmt.format(article.data.pubDate)}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
