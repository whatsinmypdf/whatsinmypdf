---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found — PDF Stowaway Scanner"
  description="This page doesn't exist. Head back to the scanner."
  pathname="/404"
>
  <section class="container py-24 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted-foreground">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block underline">Back to the scanner</a>
  </section>
</BaseLayout>
