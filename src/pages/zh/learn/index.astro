---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('learnZh')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title="文章 — PDF 隐藏文字与提示词注入"
  description="关于 PDF 隐藏文字、针对 AI 审阅者的提示词注入、白字简历套路，以及内容可以藏身何处的指南。"
  pathname="/zh/learn"
  locale="zh"
>
  <section class="container max-w-2xl py-16">
    <h1 class="text-3xl font-bold tracking-tight">文章</h1>
    <p class="mt-4 text-muted-foreground">
      PDF 如何藏匿文字、为什么隐藏指令会瞄准 AI 审阅者，以及如何检查一份文件里有没有这两者。用平实的语言解释这个扫描工具检测的各种机制。
    </p>

    <ul class="mt-10 space-y-8">
      {articles.map((article) => (
        <li class="border-t border-border pt-8">
          <a href={`/zh/learn/${article.id}`} class="group block">
            <h2 class="text-xl font-semibold group-hover:text-primary">
              {article.data.title}
            </h2>
            <p class="mt-2 text-muted-foreground">{article.data.description}</p>
            <p class="mt-3 font-mono text-xs uppercase tracking-[0.15em] text-muted-foreground">
              {dateFmt.format(article.data.pubDate)}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
