---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Scanner from '@/components/Scanner.tsx';
import { getCategories } from '@/i18n';

const categories = Object.values(getCategories('zh'));

// 这一类工具都会声称「本地处理」，所以声称本身没有信息量。下面三件事是持怀疑态度的访客一分钟之内可以自己动手核实的，每一条都是他做什么，而不是我们说什么。
const checks = [
  {
    title: '看网络面板',
    body: '打开浏览器的开发者工具，切到 Network，然后扫描一个文件。没有任何一个请求带走了这份 PDF。你还会看到 10 MB 的扫描引擎只在你真的发起扫描之后才下载，光打开这个页面不会去取它。',
  },
  {
    title: '拔掉网线',
    body: '先扫描一个文件，然后断开网络，刷新页面，再扫描另一个。两件事都照样能用：访问过一次之后，整个工具就住在你的浏览器里，没有什么需要它去联系了。',
  },
  {
    title: '读测试，别读承诺',
    body: '源码是公开的，它的测试会在扫描过程中盯着浏览器自己的网络流量，一旦有东西离开页面就让构建失败。这条测试在每次部署时都会对着这个线上站点跑一遍。',
  },
];

// 单一数据源：可见的 FAQ 区块和 FAQPage 结构化数据都从这个数组渲染，文案不会出现两处不一致。
const faqs = [
  {
    question: '我的文件会被上传吗？',
    answer:
      '不会。扫描过程完全在你的浏览器里通过 WebAssembly 完成。你的 PDF 在自己的设备上本地解码和分析，不会上传到任何服务器，不会有任何内容离开你的浏览器。',
  },
  {
    question: '它可能漏掉什么？',
    answer:
      '它读取的是 PDF 的文本层和文件结构，所以无法看到只以图片形式存在的文字——扫描件或截图没有文本层可供检查。它也可能漏掉措辞隐晦到足以绕过已知模式的指令。扫描结果干净能降低风险，但不能证明文件安全。',
  },
  {
    question: '为什么它是免费开源的？',
    answer:
      '检查一份文档里有没有隐藏内容，不应该需要把文件交给一个陌生的服务器。保持工具免费开源，意味着任何人都可以验证它确实做了它声称的事，而且没有上传任何内容。没有账号，没有付费墙。页面上没有任何第三方脚本：内容安全策略只允许加载本站域名下的脚本，这一点你可以在浏览器的网络面板里自己核实。',
  },
  {
    question: '可以用它检查简历和论文吗？',
    answer:
      '可以——这正是最常见的两种用途。你可以检查收到的一份简历里有没有隐藏关键词，也可以在把一篇论文、一份合同或一份报告交给任何自动化工具之前，先扫描它里面有没有针对 AI 审阅者或摘要工具的文字和指令。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'WhatsInMyPDF',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Web browser',
      url: new URL('/zh', Astro.site).href,
      description:
        '扫描任意 PDF，检查隐藏文字、隐形图层，以及针对 AI 审阅者的提示词注入痕迹。完全在浏览器本地运行，文件不会离开你的设备。',
      image: new URL('/og.png', Astro.site).href,
      inLanguage: 'zh-CN',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      inLanguage: 'zh-CN',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---
<BaseLayout
  title="WhatsInMyPDF — 免费本地检测 PDF 隐藏内容"
  description="扫描任意 PDF，检查隐藏文字、隐形图层，以及针对 AI 审阅者的提示词注入痕迹。100% 本地运行，文件不会离开你的浏览器。"
  pathname="/zh"
  jsonLd={jsonLd}
  locale="zh"
>
  <section class="container py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">
        本地 PDF 取证
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        找出藏在你 PDF 里的内容
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
        白底白字、隐形渲染模式、极小字号、隐藏图层，以及针对 AI 审阅者的提示词注入。100% 本地运行——文件不会离开你的浏览器。
      </p>
    </div>

    <div class="mt-12">
      <Scanner client:load locale="zh" />
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-border bg-card">
    <div class="container py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold tracking-tight">别信我们说的，自己验</h2>
        <p class="mt-3 text-muted-foreground">
          这类工具都会说文件留在你的设备上。下面三种方法可以核实这一个，都不需要你信任我们。
        </p>
      </div>
      <ol class="mx-auto mt-10 grid max-w-4xl gap-8 sm:grid-cols-3">
        {checks.map((check, i) => (
          <li class="text-center sm:text-left">
            <span class="font-mono text-sm font-bold text-primary">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-semibold">{check.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{check.body}</p>
          </li>
        ))}
      </ol>
      <!-- 用 flex + gap 控制分隔符间距，不要把「·」直接写在两个 <a> 之间：
           Astro 会折叠独立成行的文本节点周围的空白，渲染出来会紧贴链接文字。 -->
      <p
        class="mt-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-muted-foreground"
      >
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf/blob/main/tests/e2e/scan.spec.ts"
          rel="noopener noreferrer"
          target="_blank">不上传的那条测试</a
        >
        <span aria-hidden="true">·</span>
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf/blob/main/src/lib/scanner/detect.ts"
          rel="noopener noreferrer"
          target="_blank">检测逻辑</a
        >
        <span aria-hidden="true">·</span>
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf"
          rel="noopener noreferrer"
          target="_blank">整个项目，AGPL 开源</a
        >
      </p>
    </div>
  </section>

  <!-- What we detect -->
  <section class="container py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight">我们能检测什么</h2>
      <p class="mt-3 text-muted-foreground">
        十种隐藏内容，直接从文件结构里读取，而不是从渲染出来的页面上判断。
      </p>
    </div>
    <div class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
      {categories.map((cat) => (
        <div class="rounded-lg border border-border bg-card p-5">
          <div class="flex items-center gap-2">
            <h3 class="font-semibold">{cat.title}</h3>
            {cat.strongSignal && (
              <span class="rounded-full bg-danger/10 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-danger">
                强信号
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{cat.explanation}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-border bg-card">
    <div class="container py-16">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight">常见问题</h2>
        <dl class="mt-8 space-y-8">
          {faqs.map((faq) => (
            <div class="border-t border-border pt-6 first:border-t-0 first:pt-0">
              <dt class="font-semibold">{faq.question}</dt>
              <dd class="mt-2 text-muted-foreground">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
