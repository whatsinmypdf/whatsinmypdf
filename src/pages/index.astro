---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="PDF Stowaway Scanner — Find hidden content in PDFs, free and local"
  description="Scan any PDF for hidden text, invisible layers, and prompt-injection attempts aimed at AI reviewers. 100% local — files never leave your browser."
  pathname="/"
>
  <section class="container py-24 text-center">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Find what's hiding in your PDF</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
      100% local — files never leave your browser. Detect white-on-white text, invisible render
      modes, tiny fonts, hidden layers, and prompt-injection attempts aimed at AI reviewers.
    </p>
    <p class="mt-8 text-sm text-muted-foreground">Drop a PDF to scan it. Coming soon.</p>
  </section>
</BaseLayout>
