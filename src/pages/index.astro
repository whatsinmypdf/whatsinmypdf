---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Scanner from '@/components/Scanner.tsx';
import { CATEGORIES } from '@/lib/scanner/categories';

const categories = Object.values(CATEGORIES);

// Every tool in this category claims local processing, so the claim itself
// carries no information. These are the three checks a skeptical visitor can
// run in under a minute — each one is a thing they do, not a thing we say.
const checks = [
  {
    title: 'Watch the network tab',
    body: "Open your browser's developer tools, switch to Network, and scan a file. No request carries the PDF. You will also see the 10 MB scan engine download only once you ask for a scan — loading this page fetches nothing of the sort.",
  },
  {
    title: 'Pull the plug',
    body: 'Scan one file, disconnect from the network, then reload the page and scan another. Both still work: after one visit the whole tool lives in your browser, and there is nothing left for it to talk to.',
  },
  {
    title: 'Read the test, not the promise',
    body: 'The source is public, and its test suite watches the browser\'s own traffic during a scan and fails the build if anything leaves the page. That test runs on every deploy, against this live site.',
  },
];

// Single source of truth for the FAQ: the visible section and the FAQPage
// JSON-LD are both rendered from this array, so their text can never drift.
const faqs = [
  {
    question: 'Is my file uploaded?',
    answer:
      'No. The scanner runs entirely in your browser using WebAssembly. Your PDF is decoded and analyzed locally on your own device and is never uploaded to any server. Nothing leaves your browser.',
  },
  {
    question: 'What can it miss?',
    answer:
      "It reads the PDF's text layer and structure, so it cannot see text that exists only as part of an image — a scanned page or a screenshot has no text layer to inspect. It can also miss instructions phrased obscurely enough to slip past known patterns. A clean result lowers the risk but does not prove a file is safe.",
  },
  {
    question: 'Why is it free and open source?',
    answer:
      "Checking a document for hidden content should not require trusting a stranger's server with your file. Keeping the tool free and open source means anyone can verify that it does what it claims and that nothing is uploaded. There is no account and no paywall. No third-party script runs on the page at all: the content security policy allows scripts from this domain and nothing else, which you can check in your browser's network tab.",
  },
  {
    question: 'Can I use it for résumés and papers?',
    answer:
      'Yes — those are two of the most common cases. You can check a résumé you received for hidden keywords, or scan an academic paper, contract, or report for text and instructions aimed at an AI reviewer or summarizer, all before you pass the file to any automated tool.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'WhatsInMyPDF',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Web browser',
      url: new URL('/', Astro.site).href,
      description:
        'Scan any PDF for hidden text, invisible layers, and prompt-injection attempts aimed at AI reviewers. Runs entirely in your browser — files never leave your device.',
      image: new URL('/og.png', Astro.site).href,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---
<BaseLayout
  title="WhatsInMyPDF — Find hidden content in PDFs, free and local"
  description="Scan any PDF for hidden text, invisible layers, and prompt-injection attempts aimed at AI reviewers. 100% local — files never leave your browser."
  pathname="/"
  jsonLd={jsonLd}
>
  <section class="container py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">
        Local PDF forensics
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Find what's hiding in your PDF
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
        White-on-white text, invisible render modes, tiny fonts, hidden layers, and
        prompt-injection aimed at AI reviewers. 100% local — files never leave your browser.
      </p>
    </div>

    <div class="mt-12">
      <Scanner client:load />
    </div>
  </section>

  <!-- Check it yourself -->
  <section class="border-t border-border bg-card">
    <div class="container py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold tracking-tight">Don't take our word for it</h2>
        <p class="mt-3 text-muted-foreground">
          Every tool like this says your files stay on your device. Here are three ways to check
          this one, none of which require trusting us.
        </p>
      </div>
      <ol class="mx-auto mt-10 grid max-w-4xl gap-8 sm:grid-cols-3">
        {checks.map((check, i) => (
          <li class="text-center sm:text-left">
            <span class="font-mono text-sm font-bold text-primary">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-semibold">{check.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{check.body}</p>
          </li>
        ))}
      </ol>
      <!-- Flex with a gap rather than "·" typed between the anchors: Astro
           collapses the whitespace around a text node on its own line, which
           renders the separators flush against the link text. -->
      <p
        class="mt-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-muted-foreground"
      >
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf/blob/main/tests/e2e/scan.spec.ts"
          rel="noopener noreferrer"
          target="_blank">The no-upload test</a
        >
        <span aria-hidden="true">·</span>
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf/blob/main/src/lib/scanner/detect.ts"
          rel="noopener noreferrer"
          target="_blank">The detection logic</a
        >
        <span aria-hidden="true">·</span>
        <a
          class="underline"
          href="https://github.com/whatsinmypdf/whatsinmypdf"
          rel="noopener noreferrer"
          target="_blank">The whole thing, AGPL</a
        >
      </p>
    </div>
  </section>

  <!-- What we detect -->
  <section class="container py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight">What we detect</h2>
      <p class="mt-3 text-muted-foreground">
        Eleven kinds of hidden content, read from the file's structure rather than its rendered page.
      </p>
    </div>
    <div class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
      {categories.map((cat) => (
        <div class="rounded-lg border border-border bg-card p-5">
          <div class="flex items-center gap-2">
            <h3 class="font-semibold">{cat.title}</h3>
            {cat.strongSignal && (
              <span class="rounded-full bg-danger/10 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-danger">
                Strong signal
              </span>
            )}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{cat.explanation}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-border bg-card">
    <div class="container py-16">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
        <dl class="mt-8 space-y-8">
          {faqs.map((faq) => (
            <div class="border-t border-border pt-6 first:border-t-0 first:pt-0">
              <dt class="font-semibold">{faq.question}</dt>
              <dd class="mt-2 text-muted-foreground">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
