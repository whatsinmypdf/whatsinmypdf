---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { type Locale, bcp47, zhPathFor, enPathFor } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  pathname: string;
  jsonLd?: object;
  image?: string;
  locale?: Locale;
  // The not-found page is a real file (Cloudflare Pages needs root 404.html),
  // so requesting /404 itself is a 200. noindex keeps that URL out of the
  // index; missing paths still get an HTTP 404 from the same file.
  noindex?: boolean;
}

const { title, description, pathname, jsonLd, image, locale = 'en', noindex = false } = Astro.props;
const canonical = new URL(pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
const siteName = 'WhatsInMyPDF';
// Open Graph locales use underscores. The page is one language; the other
// locale is advertised as an alternate so a share card can name both.
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const ogLocaleAlternate = locale === 'zh' ? 'en_US' : 'zh_CN';

// hreflang alternates: every page pair points at both locale's URL, with
// x-default pointing at English (the site's default locale). The not-found
// page is bilingual and the only 404 — a zh alternate would be /zh/404,
// which does not exist — so it does not advertise a pair.
const enPath = locale === 'zh' ? enPathFor(pathname) : pathname;
const zhPath = locale === 'zh' ? pathname : zhPathFor(pathname);
const enHref = new URL(enPath, Astro.site);
const zhHref = new URL(zhPath, Astro.site);
---
<!doctype html>
<html lang={bcp47(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="en" href={enHref} />}
    {!noindex && <link rel="alternate" hreflang={bcp47('zh')} href={zhHref} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={enHref} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {!noindex && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* public/og.png is 1200×630. A page that passes its own image does not
        inherit those dimensions. */}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <Header pathname={pathname} locale={locale} />
    <main class="flex-1"><slot /></main>
    <Footer locale={locale} />
    {/* An import, not a body: Astro inlines a small inline script (adding a
        CSP hash to maintain) but emits an imported module as a /_astro/ file,
        which script-src 'self' already covers. */}
    <script>
      import '@/lib/registerSW';
    </script>
  </body>
</html>
