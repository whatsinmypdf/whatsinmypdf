---
import { type Locale, getUiStrings, zhPathFor } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getUiStrings(locale);
const year = new Date().getFullYear();
const privacyHref = locale === 'zh' ? zhPathFor('/privacy') : '/privacy';
const termsHref = locale === 'zh' ? zhPathFor('/terms') : '/terms';
---
<footer class="border-t border-border mt-16">
  <div class="container py-8 text-sm text-muted-foreground">
    <p>{t.footer.tagline}</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span>&copy; {year} WhatsInMyPDF</span>
      <a href={privacyHref} class="underline">{t.footer.privacy}</a>
      <a href={termsHref} class="underline">{t.footer.terms}</a>
      <a
        href="https://github.com/whatsinmypdf/whatsinmypdf"
        class="underline"
        rel="noopener noreferrer"
        target="_blank">{t.footer.sourceOnGithub}</a
      >
      <span>{t.footer.license}</span>
    </div>
  </div>
</footer>
