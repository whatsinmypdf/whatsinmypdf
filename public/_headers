# Cloudflare Pages header injection file. Applies to every response.
#
# No host outside 'self' appears anywhere in this policy, and that is load-
# bearing rather than incidental: the homepage invites visitors to open their
# network tab during a scan, so a third-party request would be a caveat that
# needs explaining on the one page whose whole argument is that nothing needs
# explaining. Cloudflare Web Analytics used to be injected here at the edge
# and was allowed for one deploy; automatic injection is now off at the zone
# level, and tests/smoke/prod.spec.ts asserts a live scan contacts no host but
# this one. Re-enabling any third party means changing that test on purpose.
#
# The script-src and style-src hashes below cover every inline <script>/<style>
# this build emits: Astro's hydration boot scripts, its astro-island CSS reset,
# and the service-worker registration from src/lib/registerSW.ts (Astro inlines
# scripts that small regardless of whether they are written inline or imported).
# The first two change only with the Astro version; the third changes whenever
# registerSW.ts does.
#
# Nobody has to remember that: tests/e2e/csp.spec.ts recomputes the hashes from
# dist/ and fails the build when this list does not match, which is cheaper
# than finding out from a visitor's console.
#
# If a future `pnpm build` fails the CSP-header e2e check (or you see
# "Refused to execute inline script/style" in the browser console), Astro's
# island runtime bytes changed — regenerate the hashes with:
#   node -e "const fs=require('fs'),c=require('crypto');const html=fs.readFileSync('dist/index.html','utf8');const re=/<(script|style)([^>]*)>([\s\S]*?)<\/\1>/g;let m;while((m=re.exec(html))){if(/\bsrc=/.test(m[2])||/application\/ld\+json/.test(m[2]))continue;console.log(m[1], 'sha256-'+c.createHash('sha256').update(m[3]).digest('base64'));}"
# and swap the two script-src hashes and the one style-src hash below. The
# JSON-LD <script type="application/ld+json"> tags do not need a hash: CSP
# script-src only governs script elements that would actually execute, and
# a non-JS type never executes as a script.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-SaCkFfPruIdTXT8/97JArQmGxiJAL2o4bBDvSgJ5y3Q=' 'sha256-4hzqoQq9XNzzcfs2Ouj753t4jHey8jYdDaMM/w0Jqt0='; style-src 'self' 'sha256-vv9IoKo7BSLbWcUHr3tNmfNVmm5L/9Cfn2H6LMk7/ow='; img-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Everything under /_astro/ is content-addressed — the filename carries a hash
# of the bytes, so a changed file is a different URL and revalidation can never
# do anything but confirm what the browser already has. Cloudflare's default
# (max-age=14400, must-revalidate) made that round-trip mandatory, which meant
# a scan failed the moment the visitor went offline: every scan spawns a worker
# that re-imports the scanner module and the 12 MB mupdf .wasm, and a
# revalidation with no network is a failed import, not a cache hit. That broke
# the one property a visitor can check for themselves — pull the plug, scan
# anyway — so it is now immutable. Verified by tests/smoke/prod.spec.ts.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script decides how long every other cached thing lives, so
# a stale copy of it outlives a deploy in a way nothing else can. Always
# revalidate.
/sw.js
  Cache-Control: no-cache
